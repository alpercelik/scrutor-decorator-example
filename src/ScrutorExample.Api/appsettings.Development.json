{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "//Caching": "Short expiration while developing, so cache behaviour is easy to observe.",
  "Caching": {
    "DefaultExpiration": "00:00:10",
    "Enabled": true,
    "KeyPrefix": "scrutor-example-dev"
  }
}
