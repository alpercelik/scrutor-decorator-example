<Project Sdk="Microsoft.NET.Sdk">

  <!--
    TargetFramework, Nullable, ImplicitUsings, LangVersion, ... all come from
    Directory.Build.props. Package versions come from Directory.Packages.props.
  -->

  <ItemGroup>
    <!-- Assembly scanning (AddClasses/FromAssemblyOf) + Decorate() fluent API. -->
    <PackageReference Include="Scrutor" />

    <!-- IMemoryCache: used by the caching decorator. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />

    <!-- ILogger / IOptions / IServiceCollection abstractions. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />

    <!-- IConfiguration: lets the composition root bind CachingOptions. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />

    <!--
      Concrete implementations needed by the composition root (AddLogging,
      AddMemoryCache, Configure<T>(IConfiguration) and the TryAdd* helpers). They
      live in the shared framework for the web app, but a class library must
      reference them explicitly.
    -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
