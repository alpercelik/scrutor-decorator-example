# Normalize line endings so a checkout on any platform produces identical diffs.
# `.editorconfig` already declares end_of_line = lf; this makes git enforce it at
# the repository level, including for files generated by templates (the Aspire
# AppHost skeleton ships CRLF, for example).

# Default: text files are stored with LF in the repository.
* text=auto eol=lf

# Windows-only scripts still need CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets are never converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.nupkg binary
*.snupkg binary
*.pfx binary
*.dll binary
*.pdb binary

# Keep diffs readable for generated/lock files.
*.slnx text eol=lf diff
Directory.Packages.props text eol=lf
